# MM-RAG Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Application
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=50

# Chunking (Phase 2)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM (Phase 5+)
LLM_API_KEY=
LLM_MODEL=

# Embeddings (Phase 3+)
EMBEDDING_MODEL=

# Vector Store (Phase 3+)
VECTOR_STORE=

