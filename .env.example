# MM-RAG Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Application
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=50

# Chunking (Phase 2)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embeddings (Phase 3)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# Vector Store (Phase 3)
VECTOR_STORE_PATH=data/vectorstore
VECTOR_STORE_COLLECTION=mmrag_chunks
VECTOR_SEARCH_TOP_K=10

# Semantic Retrieval Relevance Gate (Phase 4 / Phase 6 Grounding)
# Empirically chosen Phase 6 baseline heuristic (all-MiniLM-L6-v2 on sample doc).
# Filters out chunks with cosine similarity < threshold to prevent answering unrelated queries.
# To be reevaluated in Phase 11 evaluation.
RETRIEVAL_MIN_SCORE=0.3

# Hybrid Retrieval (Phase 8)
# Retrieval mode: "semantic" (default, Phase 6 baseline), "keyword" (BM25 only), "hybrid" (RRF fusion)
RETRIEVAL_MODE=semantic
# Per-retriever candidate counts for hybrid mode
HYBRID_SEMANTIC_TOP_K=20
HYBRID_KEYWORD_TOP_K=20
# Weights for RRF score fusion (higher = more influence)
HYBRID_SEMANTIC_WEIGHT=1.0
HYBRID_KEYWORD_WEIGHT=1.0
# RRF constant (dampens high-rank influence; standard default = 60)
RRF_K=60

# Reranking (Phase 9)
# Whether cross-encoder reranking is enabled (default false, opt-in)
RERANKER_ENABLED=false
# Cross-encoder model identifier
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Number of candidates retrieved before reranking to final top-k
RERANKER_CANDIDATE_TOP_K=20

# LLM Generation (Phase 5)
# Ollama must be installed and running: ollama serve
# Pull the verified baseline model: ollama pull qwen2.5:0.5b-instruct
# (Note: tinyllama is not recommended as it fails instruction-following/prompt-echoing acceptance tests)
LLM_MODEL=qwen2.5:0.5b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT=120.0
LLM_CONTEXT_MAX_CHARS=3000

# OCR and Image Ingestion (Phase 10)
# Tesseract 5 must be installed: winget install UB-Mannheim.TesseractOCR
# Master kill-switch for OCR execution (default true)
OCR_ENABLED=true
# OCR recognition language (Tesseract 3-letter code, e.g. eng, or combinations e.g. eng+deu)
OCR_LANGUAGE=eng
# Resolution (DPI) used to render PDF pages for OCR (72-600)
OCR_DPI=300
# Threshold for minimum native alphanumeric characters before triggering OCR check (1-10000)
OCR_MIN_NATIVE_CHARS=25
# Per-page hard execution timeout in seconds for OCR engine process (1-600)
OCR_TIMEOUT_SECONDS=60.0
# Maximum number of pages per document that can undergo OCR (1-1000)
OCR_MAX_PAGES=50
# Maximum image dimensions in total pixels allowed for rendering or decoding (1000000-200000000)
OCR_MAX_IMAGE_PIXELS=40000000
